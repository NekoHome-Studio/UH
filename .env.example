# Copy to .env and replace the empty required values or set them in the shell.
DB_PASSWORD=
UH_CLIENT_ID_SECRET=
UH_MEMORY_MASTER_KEY=

# Host files provisioned outside the checkout. Use paths visible to Compose.
UH_AUTH_TOKEN_SOURCE=/path/to/uh-auth-token
UH_PLUGIN_TRUSTED_KEYS_SOURCE=/path/to/uh-trusted-keys.json

# Paths inside the kernel container.
UH_AUTH_TOKEN_FILE=/run/secrets/uh_auth_token
UH_PLUGIN_TRUSTED_KEYS_FILE=/run/secrets/uh_plugin_trusted_keys

# Compose service DNS names. PostgreSQL receives the password separately.
UH_REDIS_URL=redis://redis:6379
UH_CHECKPOINT_BACKEND=postgres
UH_CHECKPOINT_POSTGRES_URL=postgresql://uh@postgres:5432/uh_checkpoints
UH_RETRIEVAL_BACKEND=chroma
UH_RETRIEVAL_CHROMA=http://chroma:8000

# Set the provider and its API key to enable a real model.
UH_LLM_PROVIDER=mock
UH_LLM_API_KEY=
UH_LLM_BASE_URL=https://api.openai.com/v1
UH_LLM_MODEL=gpt-4o-mini
