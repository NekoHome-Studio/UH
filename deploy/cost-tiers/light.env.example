# UH! 成本分层：轻量（light）
# 目标：个人单机 / 低占用，月成本趋近 0（本地模型 + 本地检索）
# 硬件基线建议：2 核 / 4G RAM / 无 GPU

# LLM：本地 Ollama 小模型（离线可用，无 API 费用）
UH_LLM_PROVIDER=openai
UH_LLM_BASE_URL=http://localhost:11434/v1
UH_LLM_MODEL=qwen2.5:3b
UH_LLM_API_KEY=${UH_LLM_API_KEY}
UH_LLM_MAX_TOKENS=1024
UH_LLM_TIMEOUT_S=60

# 检索：本地文件后端，不启 Chroma 容器
UH_RETRIEVAL_BACKEND=local
UH_RETRIEVAL_TOP_K=3

# 记忆：短期 fakeredis / 本地 Redis，长期本地 JSON
UH_REDIS_URL=${UH_REDIS_URL}
UH_MEMORY_SHORT_TERM_TTL_S=3600
UH_MEMORY_MASTER_KEY=${UH_MEMORY_MASTER_KEY}

# 编排：单步，不启 LangGraph checkpoint 库
UH_CHECKPOINT_BACKEND=memory

# 协作：关闭（CrewAI profile 不拉起）
UH_COLLABORATION_ENABLED=0

# 可观测性：指标开，追踪关（省资源）
UH_OTEL_ENABLED=0
UH_OTEL_SAMPLE_RATIO=0

# 沙箱：单插件低配额
UH_SANDBOX_DEFAULT_MEMORY_MB=64
UH_SANDBOX_DEFAULT_TIMEOUT_MS=3000

# 并发预期：≤10 并发（超出请升标准档）
