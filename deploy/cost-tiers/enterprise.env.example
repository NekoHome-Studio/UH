# UH! 成本分层：企业（enterprise）
# 目标：多用户 / 高质量模型 / 高可用与合规
# 硬件基线建议：8 核+ / 32G RAM+ / K8s 多副本

# LLM：旗舰模型（成本最高，质量最优）
UH_LLM_PROVIDER=openai
UH_LLM_BASE_URL=https://api.openai.com/v1
UH_LLM_MODEL=gpt-4o
UH_LLM_API_KEY=${UH_LLM_API_KEY}
UH_LLM_MAX_TOKENS=8192
UH_LLM_TIMEOUT_S=120

# 检索：Chroma + 更大召回
UH_RETRIEVAL_BACKEND=chroma
UH_RETRIEVAL_CHROMA=http://chroma:8000
UH_RETRIEVAL_TOP_K=10

# 记忆：Redis 持久化 + L2 加密（主密钥经外部 KMS 注入）
UH_REDIS_URL=redis://redis:6379
UH_MEMORY_SHORT_TERM_TTL_S=604800
UH_MEMORY_MASTER_KEY=${UH_MEMORY_MASTER_KEY}

# 编排：PostgreSQL 高可用
UH_CHECKPOINT_BACKEND=postgres
UH_CHECKPOINT_POSTGRES_URL=postgresql://uh@postgres:5432/uh_checkpoints
PGPASSWORD=${DB_PASSWORD}

# 协作：常驻可用（K8s HPA 上限提高）
UH_COLLABORATION_ENABLED=1

# 可观测性：全量追踪（合规审计需要）
UH_OTEL_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
UH_OTEL_SAMPLE_RATIO=1.0

# 沙箱：高配额 + 强制 seccomp + cgroup 委派
UH_SANDBOX_DEFAULT_MEMORY_MB=512
UH_SANDBOX_DEFAULT_TIMEOUT_MS=10000
UH_SANDBOX_SECCOMP=enforce
UH_SANDBOX_CGROUP_ROOT=/sys/fs/cgroup/uh-plugins

# 鉴权：强制生产模式
UH_LOCAL_MODE=0
UH_AUTH_REQUIRED=1
UH_AUTH_TOKEN_FILE=/run/secrets/uh_auth_token

# 并发预期：100+ 并发须 kernel replicas≥3 + 能力模块 HPA（当前单进程实测 P95 未达标，见 benchmarks/README.md）
