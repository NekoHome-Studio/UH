{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hook.schema.json",
  "title": "UH! 钩子插件 manifest（事件总线订阅，§5.4④）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "type",
    "description",
    "author",
    "license",
    "permissions",
    "entry",
    "config"
  ],
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "license": {
      "$ref": "common.schema.json#/$defs/license"
    },
    "permissions": {
      "$ref": "common.schema.json#/$defs/permissions"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/dependency"
      }
    },
    "network": {
      "$ref": "common.schema.json#/$defs/network"
    },
    "type": {
      "const": "hook"
    },
    "entry": {
      "$ref": "common.schema.json#/$defs/entry"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "memory_limit_mb",
        "events"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 5000,
          "description": "单次调用超时上限，内核侧计时（§5.2 / §9.3）"
        },
        "rate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 60,
          "description": "每分钟最大调用次数（§5.2）"
        },
        "memory_limit_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192,
          "default": 256,
          "description": "进程内存上限，超限 OOM Kill（§5.5）"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,2}$",
            "description": "订阅事件；标准事件：kernel.request.received / kernel.route.decided / capability.invoked / capability.failed / memory.write。注意：其中三个为两段命名，与 §6.6 三段约定不一致，本 schema 兼容 2~3 段，命名统一由 M1-1 冻结内部协议时裁决；未注册事件 activate 阶段失败"
          },
          "description": "订阅事件，命名 域.对象.动作（§6.6）；标准事件：kernel.request.received / kernel.route.decided / capability.invoked / capability.failed / memory.write；未注册事件 activate 阶段失败"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "network.outbound"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "required": [
          "network"
        ]
      }
    }
  ]
}
