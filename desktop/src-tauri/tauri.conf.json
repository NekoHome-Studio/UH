{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UH!",
  "version": "0.1.0",
  "identifier": "studio.nekohome.uh",
  "build": {
    "frontendDist": "http://127.0.0.1:8080/?desktop=1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UH!",
        "url": "http://127.0.0.1:8080/?desktop=1",
        "create": false,
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 420,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8080 ws://127.0.0.1:8080 ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "../../kernel/*.py": "runtime/kernel/",
      "../../ui/": "runtime/ui/",
      "../../docs/contracts/events.schema.json": "runtime/docs/contracts/events.schema.json",
      "../../docs/contracts/manifest.schema.json": "runtime/docs/contracts/manifest.schema.json",
      "../../docs/contracts/manifest/*.json": "runtime/docs/contracts/manifest/"
    }
  },
  "plugins": {
    "uh-desktop": {"wakeShortcut": "Ctrl+Alt+U"}
  }
}
